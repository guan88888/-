extends RefCounted
## Exercises actual buttons and map input, with saves isolated from player data.
const Scene = preload("res://Main.tscn")
const Rules = preload("res://game_state.gd")

static func target(test, ui, id: String) -> void:
	ui.scroll.ensure_control_visible(ui.map_view)
	await test.frames()
	var point: Vector2 = ui.map_view.global_position + ui.map_view.to_screen(ui.game.position_of(ui.game.planet(id)))
	await test.click_at(point)
	await test.frames()

static func button(test, ui, text: String) -> void:
	await test.click_button(ui,test.find_button(ui.modal if is_instance_valid(ui.modal) else ui,text))
	await test.frames()

static func run(test) -> void:
	for faction_index in range(3):
		test.root.size = Vector2i(1080,900)
		test.root.content_scale_size = Vector2i.ZERO
		var ui = Scene.instantiate()
		ui.save_directory = test.save_dir.path_join("tutorial-%d" % faction_index)
		ui.music_settings_path = ui.save_directory.path_join("audio.cfg")
		DirAccess.make_dir_recursive_absolute(ui.save_directory)
		test.root.add_child(ui)
		await test.frames()
		ui.faction_index = faction_index
		ui.mode_index = 8
		ui.seed_code = "PRACTICE%d" % faction_index
		await button(test,ui,"开启星门")
		test.expect(ui.tutorial_active and ui.tutorial_step == 0 and ui.game.state.mode == 0,"first play enters a safe standard campaign")
		var t: Dictionary = ui.game.state.tutorial.duplicate(true)
		test.expect(ui.game.adjacency(t.home,t.expand) != {} and ui.game.adjacency(t.expand,t.enemy) != {},"tutorial uses connected real gates for each faction")
		await test.snapshot("tutorial-desktop" if faction_index == 0 else "tutorial-faction-%d" % faction_index)
		if faction_index == 0:
			for resolution in [Vector2i(390,844),Vector2i(1080,600)]:
				test.root.size = resolution
				await test.frames(10)
				var hint = test.find_button(ui,"定位星图")
				if not test.fully_inside(hint,ui.get_global_rect()): print("LAYOUT ",resolution," UI ",ui.get_global_rect()," hint ",hint.get_global_rect()," shell ",ui.shell.get_global_rect())
				test.expect(test.fully_inside(hint,ui.get_global_rect()),"tutorial action fits " + str(resolution))
				test.expect(test.fully_inside(test.find_button(ui,"跳过教学"),ui.get_global_rect()),"skip stays reachable " + str(resolution))
				await test.snapshot("tutorial-mobile" if resolution.x == 390 else "tutorial-short")
			test.root.size = Vector2i(1080,900)
			await test.frames(10)
		# Merely opening a hint or selecting the wrong star must not advance.
		await button(test,ui,"定位星图")
		test.expect(ui.tutorial_step == 0,"hint does not complete selection")
		await target(test,ui,t.expand)
		test.expect(ui.tutorial_step == 0,"wrong star does not complete selection")
		await target(test,ui,t.home)
		test.expect(ui.tutorial_step == 1,"actual home click selects garrison and advances")
		await button(test,ui,"选择扩张")
		await target(test,ui,t.expand)
		test.expect(is_instance_valid(ui.modal) and ui.tutorial_step == 1,"expansion preview does not advance")
		await button(test,ui,"取消")
		test.expect(ui.tutorial_step == 1 and ui.game.state.ap == 2,"cancel leaves progress and resources intact")
		await target(test,ui,t.expand)
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 2 and ui.game.planet(t.expand).owner == ui.game.state.player,"confirmed real expansion advances")
		var state_before: Dictionary = ui.game.state.duplicate(true)
		ui._perform("buy",{"planet":t.home,"type":"守卫"})
		test.expect(ui.game.state == state_before and ui.tutorial_step == 2,"unrelated spending cannot break the exercise")
		await button(test,ui,"选择增援")
		await target(test,ui,t.home)
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 3 and ui.game.state.ap == 0,"reinforce spends the second action")
		var enemies: Array = ui.game.state.fleets.filter(func(f: Dictionary) -> bool: return f.owner != ui.game.state.player).duplicate(true)
		var credits: int = int(ui.game.res().credits)
		await button(test,ui,"结束本轮")
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 4 and ui.game.state.turn == 2 and ui.game.state.ap == 2,"round actually settles and restores two actions")
		test.expect(int(ui.game.res().credits) > credits,"real planetary income is collected")
		test.expect(enemies == ui.game.state.fleets.filter(func(f: Dictionary) -> bool: return f.owner != ui.game.state.player),"enemy commanders wait during onboarding")
		await target(test,ui,t.home)
		await button(test,ui,"选择调度")
		await target(test,ui,t.expand)
		await button(test,ui,"确认驻守")
		test.expect(ui.tutorial_step == 5 and ui.game.fleet(t.fleet).station == t.expand,"actual move arrives at expanded outpost")
		# A complete snapshot must resume the exact objective and main fleet.
		ui._save("2")
		await test.frames()
		ui.tutorial_step = 0
		ui._load("2")
		await test.frames()
		test.expect(ui.tutorial_active and ui.tutorial_step == 5 and ui.selected_fleet == t.fleet,"load restores current exercise and selected main fleet")
		await button(test,ui,"升级主力")
		await button(test,ui,"攻击力 · 进攻战力 +1")
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 6 and ui.game.fleet(t.fleet).level == 2,"real attack upgrade advances")
		await button(test,ui,"选择进攻")
		await target(test,ui,t.enemy)
		await button(test,ui,"直接突袭")
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 7 and ui.game.planet(t.enemy).owner == ui.game.state.player,"real attack wins for each faction")
		await button(test,ui,"自治管理")
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 8 and ui.game.planet(t.enemy).policy == "自治管理","occupation is followed by real governance")
		await button(test,ui,"打开外交")
		await button(test,ui,"交换情报")
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 9 and ui.game.state.diplomacy_turn == ui.game.state.turn,"actual diplomacy advances")
		await button(test,ui,"选择技能")
		await target(test,ui,t.home)
		await button(test,ui,"确认执行")
		test.expect(ui.tutorial_step == 10 and ui.game.state.skill_turn == ui.game.state.turn,"actual faction skill advances")
		await button(test,ui,"前往存档")
		await button(test,ui,"保存当前进度")
		test.expect(ui.tutorial_step == 11 and FileAccess.file_exists(ui._save_path("1")),"manual save is required for completion")
		await button(test,ui,"继续这场战役")
		test.expect(not ui.tutorial_active and not ui.game.state.tutorial.active and ui.game.state.turn == 2,"continue keeps battle and removes training protection")
		var preferences := ConfigFile.new()
		test.expect(preferences.load(ui.save_directory.path_join("onboarding.cfg")) == OK and preferences.get_value("tutorial","seen",false),"first-play preference persists in isolated directory")
		ui._start_campaign()
		await test.frames()
		test.expect(not ui.tutorial_active and ui.game.state.mode == 8,"future starts honor originally selected mode")
		ui.queue_free()
		await test.frames()
