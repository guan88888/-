	"主武器":"进攻战力 +2。", "护盾":"防守战力 +2。", "引擎":"降低移动燃料消耗，与同类燃料加成不叠加。",
	"侦察":"310 范围发现舰队，230 范围识别兵力；可主动扫描 420 范围。侦察专精每级增加 60；调查遗迹增加情报收益。", "运输":"允许使用运输舱，并增加遗迹调查的材料收益。",
	"维修":"每轮修复 1 个受损单位；没有损伤时不产生新单位。", "隐匿":"LV.2 解锁；降低被拦截的风险，移动时可避开途中拦截。",
	"帝国矩阵":"帝国专属，LV.2 解锁；防守战力 +2。", "联盟信标":"联盟专属，LV.2 解锁；驻守时每轮改善当地好感并增加信用。",
	"混沌跃迁":"混沌专属，LV.2 解锁；降低移动燃料消耗，与同类加成不叠加。"
}

static func entry(title: String) -> Array:
	if ACTIONS.has(title): return ACTIONS[title]
	for event_id in ["refugees","engineers","closed_port","defectors","pursuit","safe_route"]:
		for choice in preload("res://campaign_systems.gd").story_info(event_id).choices:
			if title == choice[0]: return ["剧情选择 · 查看代价",choice[1]]
	if title.begins_with("银河重整"): return ["第 4 轮 · 每局一次","第 4 轮解锁。所有己方星球舰队 +1，额外获得 1 行动；使用后本局不可再次使用。"]
	if title.begins_with("星门锁域"): return ["每轮一次 · 保护己星","选择己方星球，本轮敌人不能攻击该星球；再次使用需要等下一轮。"]
	if title.begins_with("自由贸易"): return ["每轮一次 · 信用 +4","选择己方星球，获得 4 信用点并改善该星球好感 8 点。"]
	if title.begins_with("暗网补给"): return ["每轮一次 · 情报与燃料","选择己方星球，获得 3 情报和 3 燃料。"]
	if title in ["帝国","联盟","混沌"]: return ["查看阵营档案","查看「%s」的背景、被动、技能和限制，不改变当前阵营。" % title]
	if title.begins_with("护盾阵列"): return ["1 行动 / 4 材料","在己方星球建造护盾阵列，防御 +2；替换原设施，重复建设无效。"]
	if title.begins_with("资源基地"): return ["1 行动 / 4 材料","在己方星球建造资源基地，信用收入 +2；替换原设施，重复建设无效。"]
	if title.ends_with("结盟"): return ACTIONS["结盟"]
	if title.begins_with("槽位 ") or title.begins_with("自动存档 ·"): return ["读取这份本地战役","恢复此槽位完整进度，替换当前未保存战局。空槽或损坏文件不会覆盖正在进行的战役。"]
	if title.begins_with("接触 "): return ["查看舰队接触选项","打开与该舰队的接触菜单。友军可合并、支援或换模块；敌军可侦察、开战、避让或停火。"]
	if "单位 · LV." in title: return ["选中这支驻守舰队","设置为当前操作舰队，然后可在星图拖动、配置、升级或拆分。"]
	if " / " in title and " 单位" in title: return ["打开舰队操作","己方舰队可选择移动、拆分和配置；其他舰队打开接触菜单。"]
	for direction in ["攻击力","防御力","移动速度","星门移动效率","远程攻击","侦察范围","运输容量","维修速度","撤退成功率","外交威慑力"]:
		if title.begins_with(direction + " ·"): return ["6 信用 / 3 材料", "升级一级并获得「%s」。最高 LV.5，确认前可取消。" % title]
	return []
